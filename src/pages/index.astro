---
import Layout from '../layouts/Layout.astro';
import tools from '../data/tools.json';

// Group tools by category
const categories = Array.from(new Set(tools.map(t => t.category))).map(catKey => {
  const catTools = tools.filter(t => t.category === catKey);
  return {
    key: catKey,
    name: catTools[0].category_name,
    count: catTools.length
  };
});
---

<Layout title="Real SaaS Pricing & Hidden Fee Calculator 2026">
  <!-- Hero Section -->
  <section class="relative overflow-hidden pt-16 pb-20 border-b border-slate-800/60 bg-gradient-to-b from-slate-900/50 via-slate-950 to-slate-950">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,_var(--tw-gradient-stops))] from-emerald-500/10 via-transparent to-transparent pointer-events-none"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
      <div class="inline-flex items-center space-x-2 px-3 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-semibold mb-6">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>2026 Developer &amp; AI Tool Pricing Teardowns</span>
      </div>

      <h1 class="text-4xl sm:text-6xl font-extrabold text-white tracking-tight leading-tight max-w-4xl mx-auto">
        Stop Overpaying for SaaS.<br/>
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 via-teal-300 to-cyan-400">
          Unmask Hidden Fees &amp; Overages.
        </span>
      </h1>

      <p class="mt-6 text-lg sm:text-xl text-slate-400 max-w-2xl mx-auto leading-relaxed">
        Compare real billing formulas, seat traps, bandwidth surcharges, and token rates for 34+ leading developer tools, databases, and AI models.
      </p>

      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a 
          href="#calculator" 
          class="w-full sm:w-auto px-8 py-3.5 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-400 hover:to-teal-400 text-black font-bold text-sm shadow-lg shadow-emerald-500/25 transition"
        >
          Launch Interactive Cost Matcher ⚡️
        </a>
        <a 
          href="#tools" 
          class="w-full sm:w-auto px-8 py-3.5 rounded-xl bg-slate-900 hover:bg-slate-850 border border-slate-800 text-slate-200 font-semibold text-sm transition"
        >
          Browse All 34 Tools Matrix
        </a>
      </div>
    </div>
  </section>

  <!-- Partner Picks (affiliate) -->
  <section class="py-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-wrap items-center gap-2 mb-4">
      <span class="text-[11px] font-bold uppercase tracking-wider text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-2 py-0.5 rounded">Partner Picks</span>
      <span class="text-[11px] text-slate-500">Tools from our index with partner links — we may earn a commission at no extra cost to you.</span>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      <div class="bg-slate-900/60 rounded-2xl border border-slate-800 hover:border-emerald-500/50 p-6 transition flex flex-col justify-between">
        <div>
          <h3 class="font-bold text-lg text-white">Make — Automation Without the Zapier Tax</h3>
          <p class="text-xs text-slate-400 leading-relaxed mt-2">Visual automation at roughly 1/5th of Zapier's price. Our teardown breaks down where Make stays cheap — and where the costs hide.</p>
        </div>
        <div class="mt-5 flex items-center gap-4 text-xs font-semibold">
          <a href="https://www.make.com/en/register?pc=stackcost" target="_blank" rel="sponsored noopener noreferrer" class="px-4 py-2.5 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-400 hover:to-teal-400 text-black font-bold transition">Try Make Free →</a>
          <a href="/tool/make/" class="text-emerald-400 hover:text-emerald-300">Read the pricing audit</a>
        </div>
      </div>
      <div class="bg-slate-900/60 rounded-2xl border border-slate-800 hover:border-emerald-500/50 p-6 transition flex flex-col justify-between">
        <div>
          <h3 class="font-bold text-lg text-white">Railway — Deploy Apps &amp; Databases in Minutes</h3>
          <p class="text-xs text-slate-400 leading-relaxed mt-2">Instant infrastructure for full-stack apps, Docker containers, and databases. Sign up through our partner link and get $20 in free credits.</p>
        </div>
        <div class="mt-5 flex items-center gap-4 text-xs font-semibold">
          <a href="https://railway.com?referralCode=zO7FcI" target="_blank" rel="sponsored noopener noreferrer" class="px-4 py-2.5 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-400 hover:to-teal-400 text-black font-bold transition">Try Railway — $20 Credits →</a>
          <a href="/tool/railway/" class="text-emerald-400 hover:text-emerald-300">Read the pricing audit</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Price Alerts (new product) -->
  <section class="pb-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-gradient-to-r from-emerald-500/15 via-slate-900 to-cyan-500/10 rounded-2xl border border-emerald-500/30 p-6 sm:p-8 flex flex-col md:flex-row md:items-center gap-6 justify-between">
      <div>
        <span class="text-[11px] font-bold uppercase tracking-wider text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-2 py-0.5 rounded">New · Price Alerts</span>
        <h3 class="font-bold text-xl text-white mt-3">SaaS prices change quietly. Your bill shouldn't find out first.</h3>
        <p class="text-sm text-slate-400 leading-relaxed mt-2 max-w-2xl">We monitor the official pricing pages of all 34 tools in our index. Gemini API prices just doubled, Jira Cloud went up 7.2%, and Harvest renewals jumped 600%+. Get the free monthly roundup before your next renewal surprises you.</p>
      </div>
      <a href="/alerts/" class="shrink-0 px-6 py-3 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-400 hover:to-teal-400 text-black text-sm font-bold shadow-md shadow-emerald-500/20 transition text-center">Get Price Alerts →</a>
    </div>
  </section>

  <!-- Interactive 30-Second Stack Cost Calculator -->
  <section id="calculator" class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-gradient-to-b from-slate-900 to-slate-900/40 rounded-3xl border border-slate-800 p-6 sm:p-10 shadow-2xl relative overflow-hidden">
      <div class="max-w-3xl mb-8">
        <div class="inline-flex items-center space-x-2 text-emerald-400 text-xs font-bold uppercase tracking-wider mb-2">
          <span>⚡️ Live Interactive Tool</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-white">Interactive SaaS Stack Budget Matcher</h2>
        <p class="text-slate-400 text-sm mt-1">Select your team size and monthly budget to reveal optimal tech stacks without hidden billing traps.</p>
      </div>

      <!-- Controls -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 bg-slate-950/60 p-6 rounded-2xl border border-slate-800/80 mb-8">
        <div>
          <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">
            Team Members: <span id="team-size-display" class="text-emerald-400 font-bold text-sm">1 (Solo Founder)</span>
          </label>
          <input 
            type="range" 
            id="team-size-slider" 
            min="1" 
            max="20" 
            value="1" 
            class="w-full h-2 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-emerald-500"
          />
          <div class="flex justify-between text-[11px] text-slate-500 mt-1">
            <span>Solo (1)</span>
            <span>Small (5)</span>
            <span>Agency (20)</span>
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Primary Workload</label>
          <select id="workload-select" class="w-full bg-slate-900 border border-slate-800 text-slate-200 rounded-xl px-3 py-2 text-sm focus:outline-none focus:border-emerald-500">
            <option value="all">All Tool Categories</option>
            <option value="ai-models">AI Models &amp; Token Inference</option>
            <option value="hosting-deployment">Cloud Hosting &amp; Edge</option>
            <option value="database-backend">Postgres &amp; Databases</option>
            <option value="automation-workflow">No-Code Automations</option>
          </select>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Trap Appetite</label>
          <select id="risk-select" class="w-full bg-slate-900 border border-slate-800 text-slate-200 rounded-xl px-3 py-2 text-sm focus:outline-none focus:border-emerald-500">
            <option value="all">Show All Options</option>
            <option value="low-trap">Zero / Very Low Cost Traps Only</option>
          </select>
        </div>
      </div>

      <!-- Results Grid -->
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-sm font-bold text-slate-300 uppercase tracking-wider">
          Top Matching Tools (<span id="calc-match-count" class="text-emerald-400">34</span> Qualified)
        </h3>
        <span class="text-xs text-slate-500">Sorted by lowest cost-trap vulnerability</span>
      </div>

      <div id="calc-results-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        <!-- Dynamically populated via JS -->
      </div>
    </div>
  </section>

  <!-- Quick Category Tabs & All Tools Grid -->
  <section id="tools" class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 border-t border-slate-800/60">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-10 gap-4">
      <div>
        <h2 class="text-3xl font-extrabold text-white tracking-tight">The 2026 SaaS Pricing Directory</h2>
        <p class="text-slate-400 text-sm mt-1">Detailed breakdowns of official pricing models vs actual real-world billing surprises.</p>
      </div>

      <!-- Filter Buttons -->
      <div id="filter-buttons" class="flex flex-wrap gap-2">
        <button type="button" data-cat="all" class="cat-filter-btn px-3 py-1.5 rounded-lg bg-emerald-500 text-black text-xs font-bold cursor-pointer transition">
          All (34)
        </button>
        <button type="button" data-cat="ai-models" class="cat-filter-btn px-3 py-1.5 rounded-lg bg-slate-900 border border-slate-800 text-slate-400 text-xs font-semibold hover:border-slate-700 cursor-pointer transition">
          AI Models (7)
        </button>
        <button type="button" data-cat="hosting-deployment" class="cat-filter-btn px-3 py-1.5 rounded-lg bg-slate-900 border border-slate-800 text-slate-400 text-xs font-semibold hover:border-slate-700 cursor-pointer transition">
          Hosting (6)
        </button>
        <button type="button" data-cat="database-backend" class="cat-filter-btn px-3 py-1.5 rounded-lg bg-slate-900 border border-slate-800 text-slate-400 text-xs font-semibold hover:border-slate-700 cursor-pointer transition">
          Databases (3)
        </button>
        <button type="button" data-cat="automation-workflow" class="cat-filter-btn px-3 py-1.5 rounded-lg bg-slate-900 border border-slate-800 text-slate-400 text-xs font-semibold hover:border-slate-700 cursor-pointer transition">
          Automation (3)
        </button>
      </div>
    </div>

    <!-- Cards Grid -->
    <div id="tools-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {tools.map(tool => (
        <a 
          href={`/tool/${tool.id}`} 
          class="tool-card group bg-slate-900/60 rounded-2xl border border-slate-800 hover:border-emerald-500/50 p-6 transition flex flex-col justify-between"
          data-category={tool.category}
          data-trap={tool.cost_trap_rating}
        >
          <div>
            <div class="flex items-start justify-between mb-3">
              <div>
                <h3 class="font-bold text-lg text-white group-hover:text-emerald-400 transition">{tool.name}</h3>
                <span class="text-xs text-slate-500">{tool.category_name}</span>
              </div>
              <span class={`text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded border ${
                tool.cost_trap_rating === 'Very High' ? 'bg-red-500/10 text-red-400 border-red-500/30' :
                tool.cost_trap_rating === 'High' ? 'bg-orange-500/10 text-orange-400 border-orange-500/30' :
                tool.cost_trap_rating === 'Medium' ? 'bg-yellow-500/10 text-yellow-400 border-yellow-500/30' :
                'bg-emerald-500/10 text-emerald-400 border-emerald-500/30'
              }`}>
                {tool.cost_trap_rating} Trap Risk
              </span>
            </div>

            <p class="text-xs text-slate-400 leading-relaxed mb-4 line-clamp-2">{tool.headline}</p>

            <div class="bg-slate-950/80 rounded-xl p-3 border border-slate-850 mb-4 space-y-1.5 text-xs">
              <div class="flex justify-between">
                <span class="text-slate-500">Starting Price:</span>
                <span class="text-slate-200 font-semibold">{tool.starting_price}</span>
              </div>
              <div class="flex justify-between">
                <span class="text-slate-500">Free Tier:</span>
                <span class="text-emerald-400 font-medium truncate max-w-[180px]">{tool.free_tier.slice(0, 32)}...</span>
              </div>
            </div>

            <div class="space-y-1">
              <span class="text-[11px] font-bold text-red-400/90 uppercase tracking-wider flex items-center">
                <span>⚠️ Top Hidden Cost:</span>
              </span>
              <p class="text-[11px] text-slate-400 line-clamp-2 italic">
                "{tool.hidden_costs[0]}"
              </p>
            </div>
          </div>

          <div class="mt-6 pt-4 border-t border-slate-800/80 flex items-center justify-between text-xs font-semibold text-emerald-400 group-hover:text-emerald-300">
            <span>Read Full Pricing Audit</span>
            <span>→</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Client-side script for interactive calculator and filter tabs -->
  <script define:vars={{ tools }}>
    function initApp() {
      // 1. Interactive Budget Calculator
      const slider = document.getElementById('team-size-slider');
      const teamDisplay = document.getElementById('team-size-display');
      const workloadSelect = document.getElementById('workload-select');
      const riskSelect = document.getElementById('risk-select');
      const calcGrid = document.getElementById('calc-results-grid');
      const countDisplay = document.getElementById('calc-match-count');

      function updateCalc() {
        const teamSize = parseInt(slider.value, 10);
        teamDisplay.innerText = teamSize === 1 ? '1 (Solo Founder)' : `${teamSize} Members`;

        const workload = workloadSelect.value;
        const risk = riskSelect.value;

        const filtered = tools.filter(t => {
          if (workload !== 'all' && t.category !== workload) return false;
          if (risk === 'low-trap' && !['Low', 'Very Low'].includes(t.cost_trap_rating)) return false;
          return true;
        });

        countDisplay.innerText = filtered.length;

        // Render top 6
        calcGrid.innerHTML = filtered.slice(0, 6).map(t => `
          <div class="bg-slate-950 p-5 rounded-2xl border border-slate-800 flex flex-col justify-between">
            <div>
              <div class="flex justify-between items-start mb-2">
                <h4 class="font-bold text-white text-base">${t.name}</h4>
                <span class="text-[10px] font-semibold text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-500/20">
                  ${t.cost_trap_rating} Risk
                </span>
              </div>
              <p class="text-xs text-slate-400 mb-3">${t.headline}</p>
              <div class="text-xs text-slate-400 bg-slate-900/80 p-2.5 rounded-lg mb-3">
                <span class="text-slate-500 block mb-0.5">Est. Team Cost (${teamSize} seat):</span>
                <span class="text-white font-mono font-bold">$${teamSize * t.base_cost_monthly}/mo</span>
              </div>
            </div>
            <a href="/tool/${t.id}" class="text-xs font-bold text-emerald-400 hover:text-emerald-300 flex items-center justify-between pt-2 border-t border-slate-900">
              <span>View Pricing Calculator</span>
              <span>→</span>
            </a>
          </div>
        `).join('');
      }

      slider.addEventListener('input', updateCalc);
      workloadSelect.addEventListener('change', updateCalc);
      riskSelect.addEventListener('change', updateCalc);
      updateCalc();

      // 2. Directory Category Filter Buttons
      const buttons = document.querySelectorAll('.cat-filter-btn');
      const cards = document.querySelectorAll('.tool-card');

      buttons.forEach(btn => {
        btn.addEventListener('click', () => {
          const cat = btn.getAttribute('data-cat');

          buttons.forEach(b => {
            b.className = 'cat-filter-btn px-3 py-1.5 rounded-lg bg-slate-900 border border-slate-800 text-slate-400 text-xs font-semibold hover:border-slate-700 cursor-pointer transition';
          });
          btn.className = 'cat-filter-btn px-3 py-1.5 rounded-lg bg-emerald-500 text-black text-xs font-bold cursor-pointer transition';

          cards.forEach(card => {
            const cardCat = card.getAttribute('data-category');
            if (cat === 'all' || cardCat === cat) {
              card.style.display = 'flex';
            } else {
              card.style.display = 'none';
            }
          });
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initApp);
    } else {
      initApp();
    }
  </script>
</Layout>
