---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "Real SaaS pricing calculators, hidden fees exposed, and side-by-side alternative matrices for 28+ modern developer, AI, and cloud tools." } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>⚡️</text></svg>" />
    <title>{title} | StackCost Matrix</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={`https://stackcost.apexcraftweb.com${Astro.url.pathname}`} />

    <!-- Open Graph -->
    <meta property="og:title" content={`${title} | StackCost Matrix`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`https://stackcost.apexcraftweb.com${Astro.url.pathname}`} />

    <!-- Google font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
    <style>
      body { font-family: 'Plus Jakarta Sans', sans-serif; }
      code, pre, .font-mono { font-family: 'JetBrains Mono', monospace; }
    </style>
  </head>
  <body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col selection:bg-emerald-500 selection:text-black">
    <!-- Top Announcement Banner -->
    <div class="bg-gradient-to-r from-emerald-600 via-teal-600 to-cyan-600 px-4 py-2 text-center text-xs font-semibold text-white tracking-wide">
      <span>🔥 2026 SaaS Hidden Fee Index: How Top Founders Save $400+/mo on Overages &amp; Token Markups</span>
      <a href="/pricing-calculator" class="ml-2 underline font-bold hover:text-emerald-100">Run Free Audit →</a>
    </div>

    <!-- Navigation Header -->
    <header class="border-b border-slate-800/80 bg-slate-950/80 backdrop-blur-md sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center space-x-2.5 group">
          <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-emerald-500 to-cyan-400 flex items-center justify-center text-black font-black text-lg shadow-lg shadow-emerald-500/20 group-hover:scale-105 transition">
            ⚡️
          </div>
          <div class="flex flex-col">
            <span class="font-extrabold text-base tracking-tight text-white flex items-center">
              Stack<span class="text-emerald-400">Cost</span>
              <span class="ml-1.5 px-1.5 py-0.5 text-[10px] uppercase font-bold tracking-wider bg-slate-800 text-emerald-400 border border-emerald-500/30 rounded">Matrix</span>
            </span>
            <span class="text-[10px] text-slate-400 -mt-0.5">Real SaaS Pricing &amp; Hidden Trap Tracker</span>
          </div>
        </a>

        <nav class="hidden md:flex items-center space-x-6 text-sm font-medium text-slate-300">
          <a href="/#categories" class="hover:text-emerald-400 transition">Categories</a>
          <a href="/#tools" class="hover:text-emerald-400 transition">All 28 Tools</a>
          <a href="/#calculator" class="hover:text-emerald-400 transition">Cost Calculator</a>
          <a href="/compare/vercel-vs-cloudflare-pages" class="hover:text-emerald-400 transition">Top Comparisons</a>
        </nav>

        <div class="flex items-center space-x-3">
          <a 
            href="https://2683573618956.gumroad.com/l/byryi" 
            target="_blank"
            rel="noopener noreferrer"
            class="px-3.5 py-2 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-400 hover:to-teal-400 text-black text-xs font-bold shadow-md shadow-emerald-500/20 transition flex items-center space-x-1.5"
          >
            <span>Get Cost Optimizer Kit</span>
            <span>⚡️</span>
          </a>
        </div>
      </div>
    </header>

    <!-- Main Body Slot -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-slate-800/80 bg-slate-900/60 mt-20 pt-12 pb-10 text-slate-400 text-xs">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-4 gap-8 mb-12">
        <div class="space-y-3 md:col-span-1">
          <div class="flex items-center space-x-2">
            <div class="w-6 h-6 rounded-lg bg-emerald-500 flex items-center justify-center text-black font-black text-xs">⚡️</div>
            <span class="font-bold text-white text-sm">StackCost Matrix</span>
          </div>
          <p class="text-slate-400 leading-relaxed">
            Independent, un-sponsored pricing teardowns and hidden fee audits for modern SaaS, cloud backends, and AI models.
          </p>
        </div>

        <div>
          <h4 class="font-bold text-slate-200 text-sm mb-3">Popular Comparisons</h4>
          <ul class="space-y-2">
            <li><a href="/compare/vercel-vs-cloudflare-pages" class="hover:text-emerald-400 transition">Vercel vs Cloudflare Pages</a></li>
            <li><a href="/compare/openai-api-vs-deepseek-api" class="hover:text-emerald-400 transition">OpenAI API vs DeepSeek API</a></li>
            <li><a href="/compare/supabase-vs-neon-postgres" class="hover:text-emerald-400 transition">Supabase vs Neon Postgres</a></li>
            <li><a href="/compare/zapier-vs-make" class="hover:text-emerald-400 transition">Zapier vs Make</a></li>
          </ul>
        </div>

        <div>
          <h4 class="font-bold text-slate-200 text-sm mb-3">Tool Categories</h4>
          <ul class="space-y-2">
            <li><a href="/#categories" class="hover:text-emerald-400 transition">AI Models &amp; APIs</a></li>
            <li><a href="/#categories" class="hover:text-emerald-400 transition">Database &amp; Cloud Backend</a></li>
            <li><a href="/#categories" class="hover:text-emerald-400 transition">Hosting &amp; Edge Deployment</a></li>
            <li><a href="/#categories" class="hover:text-emerald-400 transition">Automation &amp; Workflow</a></li>
          </ul>
        </div>

        <div>
          <h4 class="font-bold text-slate-200 text-sm mb-3">Legal &amp; Disclosure</h4>
          <ul class="space-y-2">
            <li><a href="/disclosure" class="hover:text-emerald-400 transition">Affiliate Disclosure</a></li>
            <li><a href="/privacy" class="hover:text-emerald-400 transition">Privacy Policy</a></li>
            <li><a href="/terms" class="hover:text-emerald-400 transition">Terms of Service</a></li>
            <li><span class="text-slate-500">Updated weekly with live pricing data.</span></li>
          </ul>
        </div>
      </div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 border-t border-slate-800 pt-6 flex flex-col sm:flex-row items-center justify-between text-slate-400">
        <p>© 2026 StackCost Matrix. All rights reserved.</p>
        <p class="mt-2 sm:mt-0 text-[11px] text-slate-400">Not affiliated with any vendor listed. All trademarks belong to their respective owners.</p>
      </div>
    </footer>
  </body>
</html>
